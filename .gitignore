node_modules/
.cache/
out/
input/*
!input/README.md
# large media never goes into git: voiceovers are uploaded as GitHub release assets,
# music/SFX stems are generated in the cloud, finished videos are downloaded into videos/<slug>/output/
*.wav
*.WAV
*.mp3
*.flac
*.m4a
*.mp4
*.mov
videos/*/output/
videos/*/qa/
videos/*/stills/
!library/**/*.wav
!library/**/*.mp3
!library/**/*.flac
# auto sound cues are regenerated by the cloud render (tools/sfx-scan.mjs)
videos/*/sfx/_auto.json
public/_active/
# reference videos are other creators' work: pictures, transcripts and audio stay on this PC only
# (git keeps only our own analysis: README/STUDY/report + numbers)
references/*/overview/
references/*/shots/
references/*/timing/

# local A/B samples for the owner (never published)
samples/
# library-only art batch copied for local tests (the library itself is in library/art)
public/_night-lib/

# the owner's UNRELEASED script and its word timing stay on this PC (owner 2026-11-11); the cloud gets them sealed.
# Only the word TIMES (numbers, no words) are committed — the render needs when words are spoken, not what.
videos/*/script.txt
videos/*/timing/*
!videos/*/timing/times.json
# layout scan output (regenerated by every gate run)
videos/*/layout-scan.json
# Short props hold the spoken words (unreleased script) — local only; the cloud gets them sealed
videos/*/shorts/
